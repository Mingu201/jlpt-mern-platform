{
  "name": "jlpt-mern-platform",
  "version": "1.0.0",
  "description": "Full-stack JLPT N5-N3 Japanese Learning Platform (Reading, Listening, Speaking, Writing)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
